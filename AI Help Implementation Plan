### Component 14: Module Registration

#### [NEW] `HelpModuleServiceRegistration.cs`
```csharp
public static class HelpModuleServiceRegistration
{
    public static IServiceCollection AddHelpModule(this IServiceCollection services, IConfiguration config)
    {
        // DbContext
        services.AddDbContext<HelpDbContext>(options =>
            options.UseSqlServer(config.GetConnectionString("DefaultConnection")));
        
        // AI Services — Singletons (expensive, thread-safe)
        services.AddSingleton<OnnxEmbeddingService>();
        services.AddSingleton<IEmbeddingService>(sp => sp.GetRequiredService<OnnxEmbeddingService>());
        services.AddSingleton<VectorIndex>();
        services.AddSingleton<IVectorIndex>(sp => sp.GetRequiredService<VectorIndex>());
        services.AddSingleton<LocalLlmService>();
        services.AddSingleton<IntentClassifier>();
        services.AddSingleton<ModelDownloadService>();
        
        // Response Generators — both registered, resolved by availability
        services.AddScoped<LocalLlmResponseGenerator>();
        services.AddScoped<TemplateResponseGenerator>();
        services.AddScoped<IResponseGenerator>(sp =>
        {
            var llm = sp.GetRequiredService<LocalLlmResponseGenerator>();
            return llm.IsAvailable ? llm : sp.GetRequiredService<TemplateResponseGenerator>();
        });
        
        // Application Services
        services.AddScoped<IChatbotService, ChatbotService>();
        services.AddScoped<IStepByStepGuideEngine, StepByStepGuideEngine>();
        services.AddScoped<IRouteToTopicMapper, RouteToTopicMapper>();
        
        // Background ingestion
        services.AddHostedService<DocumentIngestionHostedService>();
        
        // MediatR + Validation
        services.AddMediatR(cfg => cfg.RegisterServicesFromAssembly(typeof(HelpModuleServiceRegistration).Assembly));
        services.AddValidatorsFromAssembly(typeof(HelpModuleServiceRegistration).Assembly);
        
        // Menu provider
        services.AddScoped<IMenuDefinitionProvider, HelpMenuProvider>();
        
        return services;
    }
}
```

