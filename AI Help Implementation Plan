    protected override void OnModelCreating(ModelBuilder builder)
    {
        builder.HasDefaultSchema("help");
        
        // Explicit tenant filter — NO ApplyGlobalTenantFilter (project convention)
        builder.Entity<HelpArticle>().HasQueryFilter(x =>
            _currentTenantService == null ||
            _currentTenantService.IsHostAdmin ||
            x.TenantId == _currentTenantService.TenantId);
        
        builder.Entity<HelpInteraction>().HasQueryFilter(x =>
            _currentTenantService == null ||
            _currentTenantService.IsHostAdmin ||
            x.TenantId == _currentTenantService.TenantId);
        
        builder.Entity<ChatSession>().HasQueryFilter(x =>
